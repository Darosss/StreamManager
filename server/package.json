{
  "name": "stream-manager-server",
  "version": "1.0.0",
  "description": "Server for Stream Manager repository",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run start:dev",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development tsc-watch --compileCommand tsc --onSuccess \"nodemon --inspect dist/index.js --ignore public/ --ignore '*.json'\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "format:staged": "prettier --write --ignore-unknown",
    "test": "cross-env NODE_ENV=test jest --testTimeout=5000",
    "test:unit": "cross-env NODE_ENV=test jest --testTimeout=5000 --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest --testTimeout=5000 --selectProjects integration"
  },
  "keywords": [],
  "author": "Darosss",
  "license": "MIT",
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-http": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "bgutils-js": "^4.0.3",
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "get-audio-duration": "^4.0.1",
    "googleapis": "^189.0.0",
    "googlevideo": "^5.0.1",
    "jsdom": "^30.1.3",
    "module-alias": "^2.3.5",
    "mongoose": "^9.1.5",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "tmi.js": "^1.8.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "youtubei.js": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/tmi.js": "^1.8.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "29.7",
    "jest-util": "29.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsc-watch": "^7.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "_moduleAliases": {
    "@controllers": "dist/controllers",
    "@configs": "dist/configs",
    "@models": "dist/models",
    "@middlewares": "dist/middlewares",
    "@utils": "dist/utils",
    "@services": "dist/services",
    "@defaults": "dist/defaults",
    "@socket": "dist/socketIO"
  }
}
